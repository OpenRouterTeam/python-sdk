+def _encode_path_param(value: str) -> str:
+    # Percent-encode "/", "?", "#" etc. so a value can't change the request path.
+    # "." and ".." contain no encodable chars and would still be dot segments.
+    if value in (".", ".."):
+        raise ValueError(f"path parameter cannot be {value!r}")
+    return quote(value, safe="")
